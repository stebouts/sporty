{
  "info": {
    "name": "Sporty Betting API",
    "description": "Sports Betting Settlement Trigger Service — REST API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Bets",
      "item": [
        {
          "name": "Get All Bets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bets"]
            }
          },
          "response": [
            {
              "name": "200 OK — seeded bets",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/bets",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "bets"]
                }
              },
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "[\n  {\"betId\":\"bet-001\",\"userId\":\"user-1\",\"eventId\":\"event-100\",\"eventMarketId\":\"market-A\",\"eventWinnerId\":\"team-A\",\"betAmount\":50.00},\n  {\"betId\":\"bet-002\",\"userId\":\"user-2\",\"eventId\":\"event-100\",\"eventMarketId\":\"market-A\",\"eventWinnerId\":\"team-B\",\"betAmount\":30.00},\n  {\"betId\":\"bet-003\",\"userId\":\"user-3\",\"eventId\":\"event-100\",\"eventMarketId\":\"market-A\",\"eventWinnerId\":\"team-A\",\"betAmount\":20.00},\n  {\"betId\":\"bet-004\",\"userId\":\"user-4\",\"eventId\":\"event-200\",\"eventMarketId\":\"market-B\",\"eventWinnerId\":\"team-C\",\"betAmount\":75.00},\n  {\"betId\":\"bet-005\",\"userId\":\"user-5\",\"eventId\":\"event-200\",\"eventMarketId\":\"market-B\",\"eventWinnerId\":\"team-D\",\"betAmount\":40.00}\n]"
            }
          ]
        },
        {
