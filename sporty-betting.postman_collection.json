              "host": ["{{baseUrl}}"],
              "path": ["api", "event-outcomes"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"event-100\",\n  \"eventName\": \"Champions League Final\",\n  \"eventWinnerId\": \"team-A\"\n}",
              "options": {
