          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bets/event/event-100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bets", "event", "event-100"]
            }
          },
          "response": [
            {
              "name": "200 OK — bets for event-100",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/bets/event/event-100",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "bets", "event", "event-100"]
                }
              },
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "[\n  {\"betId\":\"bet-001\",\"userId\":\"user-1\",\"eventId\":\"event-100\",\"eventMarketId\":\"market-A\",\"eventWinnerId\":\"team-A\",\"betAmount\":50.00},\n  {\"betId\":\"bet-002\",\"userId\":\"user-2\",\"eventId\":\"event-100\",\"eventMarketId\":\"market-A\",\"eventWinnerId\":\"team-B\",\"betAmount\":30.00},\n  {\"betId\":\"bet-003\",\"userId\":\"user-3\",\"eventId\":\"event-100\",\"eventMarketId\":\"market-A\",\"eventWinnerId\":\"team-A\",\"betAmount\":20.00}\n]"
            },
            {
              "name": "200 OK — no bets for event",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/bets/event/event-999",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "bets", "event", "event-999"]
                }
              },
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "[]"
            }
          ]
        },
        {
          "name": "Create Bet",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/bets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bets"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"betId\": \"bet-new-001\",\n  \"userId\": \"user-10\",\n  \"eventId\": \"event-100\",\n  \"eventMarketId\": \"market-A\",\n  \"eventWinnerId\": \"team-A\",\n  \"betAmount\": 100.00\n}",
              "options": {
                "raw": {"language": "json"}
              }
            }
          },
          "response": [
            {
              "name": "200 OK — bet created",
              "status": "OK",
              "code": 200,
              "originalRequest": {
