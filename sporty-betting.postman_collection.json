                }
              },
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"betId\": \"bet-new-001\",\n  \"userId\": \"user-10\",\n  \"eventId\": \"event-100\",\n  \"eventMarketId\": \"market-A\",\n  \"eventWinnerId\": \"team-A\",\n  \"betAmount\": 100.00\n}"
            }
          ]
        }
      ]
    },
    {
